# Auth
AUTH_SECRET=           # Generate with: openssl rand -base64 32
# Public URL of this app (must match the address users open, including port).
# Dev uses 3081 — see package.json "dev" / "start".
# The Entra app registration must list a matching redirect URI, or sign-in fails
# with AADSTS50011 before any app code runs (auth.config.ts sets trustHost: true,
# so the redirect_uri follows the incoming Host, not this value):
#   http://localhost:3081/api/auth/callback/microsoft-entra-id
# Production example:
# NEXTAUTH_URL=https://test.m-group.com
NEXTAUTH_URL=http://localhost:3081

# Database (MSSQL)
MSSQL_HOST=localhost
MSSQL_PORT=1433
# Default catalogue for the connection. Every pool in src/lib/db/mssql.ts opens an
# explicitly named database (the three below, plus Rocks_Portal_HR / Rocks_Codex),
# so this value is never actually connected to — but src/env.ts requires it to be
# non-empty. Any database the login can reach will do; Fast_Core is the safe answer.
# NOT Rocks_Codex_UAT — dropped 2026-06-20, it now fails with "Login failed for user".
MSSQL_DATABASE=Fast_Core
MSSQL_USER=sa
MSSQL_PASSWORD=
MSSQL_ENCRYPT=false
MSSQL_TRUST_CERT=true
MSSQL_TLS_SERVER_NAME=
MSSQL_CORE_DATABASE=Fast_Core
# Form Portal's own database. PROD deployments use Rocks_Portal_Form; the UAT
# deployment uses Rocks_Portal_Form_UAT. Fast_Form belongs to the Rocks Fast
# sibling — pointing this at it makes both apps write to the same rows again.
MSSQL_FORM_DATABASE=Rocks_Portal_Form
# UAT twin of the form database. A form flagged UAT at Settings → Form
# Environment reads and writes here; every other form uses the line above.
MSSQL_FORM_UAT_DATABASE=Rocks_Portal_Form_UAT
MSSQL_DATA_DATABASE=Fast_Data
MSSQL_ERP_DATA_DATABASE=Rocks_ERP_Data

# External DB connections (encrypted passwords in Fast_Core.dbo.DbConnection)
# Generate with: openssl rand -base64 32
CONNECTION_ENCRYPTION_KEY=

# Azure AD (Microsoft Entra ID)
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=

# Graph API (Email — requires Mail.Send permission)
GRAPH_MAIL_FROM=noreply@rocksgroup.com

# Every email a UAT-flagged form would send goes here instead, with a [UAT]
# subject prefix and the intended recipient named in the body. Approval chains
# resolve against production HR in both environments, so without this a tester's
# fake request emails a real manager asking for approval.
# When neither this nor GRAPH_MAIL_FROM is set, UAT mail is refused rather than
# delivered to the real recipient.
UAT_MAIL_REDIRECT=

# SharePoint (Accounting AP-1 file storage; uses the Azure AD app above)
# Azure app needs application permission Sites.ReadWrite.All (or Sites.Selected
# for the target site) with admin consent. When unset, files fall back to local disk.
# Site address form: {hostname}:/sites/{name}  e.g. contoso.sharepoint.com:/sites/Accounting
SHAREPOINT_ACC_SITE=
# Base folder within the site's document library (files go under {this}/AP-1/{year}/{requestNo})
SHAREPOINT_ACC_FOLDER=

# OpenRouteService (AP-1 fallback until Google Maps connects)
# Free key: https://openrouteservice.org → Dashboard → Tokens
ORS_API_KEY=

# Google Maps (AP-1 when ready, office forms route field)
# Prefer Settings → Google Maps (Fast_Core AppSetting); .env is fallback for dev
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# App (browser-visible origin; keep in sync with NEXTAUTH_URL in dev)
# Production example:
# NEXT_PUBLIC_APP_URL=https://test.m-group.com
NEXT_PUBLIC_APP_URL=http://localhost:3081

# Local development only — manager-step approval bypass.
# When set to 1 on a non-production build served from localhost:3081, any
# signed-in user may action the AP-1/AP-17 manager step. Off unless set: this
# used to be decided by the Host header alone, which a client can choose.
# Never set this on a deployed host; a production build ignores it regardless.
# ACC_MANAGER_DEV_BYPASS=1

# Storage
# LEAVE THIS EMPTY. It is dead configuration in Form Portal, kept only because the
# code path still exists.
#
# Attachments go to SharePoint (see the block above) and there is no local
# fallback. UPLOAD_ROOT feeds src/lib/storage.ts, which is reached only for an
# AccRequestFile row whose StorageBackend is not 'sharepoint' — and there are none:
# measured 2026-08-19, Rocks_Portal_Form has zero AccRequestFile rows and the UAT
# twin has 2, all 'sharepoint'. The genuinely legacy local files belong to the
# Rocks Fast sibling and are recorded in ITS database (Fast_Form), not here.
#
# Unset, it resolves to {cwd}/uploads/forms — harmless precisely because nothing
# reads it. Only set it if you are restoring rows that predate SharePoint storage,
# in which case it must point at the sibling checkout's uploads/forms on THIS
# machine (the path differs per developer; quote it if it contains spaces).
#
# Either way, every path is containment-checked: a stored path that resolves
# outside the root is refused on read, write and delete rather than followed.
UPLOAD_ROOT=
