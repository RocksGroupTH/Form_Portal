# Auth
AUTH_SECRET=           # Generate with: openssl rand -base64 32
# Public URL of this app (must match the address users open, including port).
# Dev uses 3021 — see package.json "dev" / "start".
# Production example:
# NEXTAUTH_URL=https://test.m-group.com
NEXTAUTH_URL=http://localhost:3021

# Database (MSSQL)
MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_DATABASE=RocksFast
MSSQL_USER=sa
MSSQL_PASSWORD=
MSSQL_ENCRYPT=false
MSSQL_TRUST_CERT=true
MSSQL_TLS_SERVER_NAME=
MSSQL_CORE_DATABASE=Fast_Core
MSSQL_FORM_DATABASE=Fast_Form
MSSQL_DATA_DATABASE=Fast_Data

# External DB connections (encrypted passwords in Fast_Core.dbo.DbConnection)
# Generate with: openssl rand -base64 32
CONNECTION_ENCRYPTION_KEY=

# Azure AD (Microsoft Entra ID)
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=

# Graph API (Email — requires Mail.Send permission)
GRAPH_MAIL_FROM=noreply@rocksgroup.com

# SharePoint (Accounting AP-1 file storage; uses the Azure AD app above)
# Azure app needs application permission Sites.ReadWrite.All (or Sites.Selected
# for the target site) with admin consent. When unset, files fall back to local disk.
# Site address form: {hostname}:/sites/{name}  e.g. contoso.sharepoint.com:/sites/Accounting
SHAREPOINT_ACC_SITE=
# Base folder within the site's document library (files go under {this}/AP-1/{year}/{requestNo})
SHAREPOINT_ACC_FOLDER=

# OpenRouteService (AP-1 fallback until Google Maps connects)
# Free key: https://openrouteservice.org → Dashboard → Tokens
ORS_API_KEY=

# Google Maps (AP-1 when ready, office forms route field)
# Prefer Settings → Google Maps (Fast_Core AppSetting); .env is fallback for dev
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# App (browser-visible origin; keep in sync with NEXTAUTH_URL in dev)
# Production example:
# NEXT_PUBLIC_APP_URL=https://test.m-group.com
NEXT_PUBLIC_APP_URL=http://localhost:3021

# Storage
# Local attachment root (Form Builder + legacy accounting files).
# Point this at the Rocks Fast uploads folder so existing files stay downloadable.
UPLOAD_ROOT=c:/Users/PC/source/repos/Web/RocksFast/uploads/forms
